# ─────────────────────────────────────────────────────────────────────────
# Daily Global Pulse — TrueNAS deployment .env
#
# Copy to .env, fill in the values, and reference this file from the
# TrueNAS Custom App OR from the docker compose CLI. Never commit .env.
# ─────────────────────────────────────────────────────────────────────────

# ─ Required ────────────────────────────────────────────────────────────

# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Public clone URL for the repo (NAS will git pull this every run)
GIT_REPO_URL=https://github.com/<you>/whatsUpIn24Hrs.git

# Dataset paths on the NAS — must exist before first run.
OUTPUT_PATH=/mnt/tank/apps/dailypulse/output
CONTENT_PATH=/mnt/tank/apps/dailypulse/content
LOGS_PATH=/mnt/tank/apps/dailypulse/logs
WORKSPACE_PATH=/mnt/tank/apps/dailypulse/workspace
PLAYWRIGHT_PATH=/mnt/tank/apps/dailypulse/playwright

# ─ Optional ────────────────────────────────────────────────────────────

GIT_BRANCH=main
RETENTION_DAYS=30
SHOW_NAME=Daily Global Pulse

# Anthropic / TTS / video tuning
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
TTS_VOICE=en-US-AndrewNeural
TTS_RATE=-5%
VIDEO_FPS=30

# Viewer
VIEWER_PORT=8088

# Resource ceilings on the builder container (the heavy one)
BUILDER_CPUS=2.0
BUILDER_MEMORY=2g
